# Copy to llm/.env and fill in. .env is git-ignored - never commit your real key.

# Which backend answers by default ("groq" or "tinygpt"). You can also switch per message
# in the browser, so this is only the initial choice.
LLM_BACKEND=groq

# ---- Groq Cloud (capable chat models: Llama, etc.) -------------------------------------
# Get a key at https://console.groq.com/keys . The conversation is sent to Groq's servers,
# so only use de-identified text.
GROQ_API_KEY=
# Default model id. Groq's catalogue changes; the UI also lists live models in a dropdown,
# so if this one is gone just pick another there.
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- genetics lookups for the Groq model ----------------------------------------------
# Local database built from the AI-Analyser resources (see webui/README.md, "Genetics
# lookups"). Missing file -> the chat still works, just without lookups.
# GENETICS_DB=data/genetics.sqlite
# GENETICS_TOOLS=true           # give the model the lookup tools + genetics instructions
# GENETICS_ONLINE=true          # allow NCBI name search + gnomAD frequencies (gene/variant
#                               # names only leave the machine, never the rest of the chat)
# GENETICS_VEP=true             # local VEP/AlphaMissense/PubMed IDs via WSL
# GENETICS_WSL_DISTRO=Ubuntu
# GENETICS_WSL_RESOURCES=/root/wes/resources
# GENETICS_WSL_TOOLS_BIN=/root/wes/tools/mamba/envs/wes/bin

# ---- tinygpt (our own from-scratch model: local, completion only) ----------------------
# Train a checkpoint first with `python train.py`. Default path shown below.
# TINYGPT_CKPT=checkpoints/shakespeare_char/best.pt
# TINYGPT_DEVICE=cpu            # blank = auto (cuda if available, else cpu)
# TINYGPT_WARM_START=true       # load the checkpoint at startup so the first reply is fast

# ---- generation defaults (the browser can override) ------------------------------------
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.8
# LLM_TOP_K=40

# ---- server ----------------------------------------------------------------------------
# LLM_HOST=127.0.0.1
# LLM_PORT=8080
