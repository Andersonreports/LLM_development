# Copy to .env and fill in. Every setting in wes/config.py can be overridden here.

# --- AI interpretation -------------------------------------------------------
# "local": a model served by Ollama on this machine; no case data leaves the network.
#   Install once:  ollama pull qwen3.5:4b
# "claude": the Anthropic API. Sends de-identified case data off-site, needs
#   ANTHROPIC_API_KEY and `pip install anthropic`. Only enable deliberately.
# WES_AI_BACKEND=local
# WES_OLLAMA_MODEL=qwen3.5:4b
# WES_OLLAMA_URL=http://127.0.0.1:11434
# WES_OLLAMA_NUM_CTX=32768       # lower if the GPU runs out of memory
# WES_OLLAMA_THINK=false         # true = model reasons first: better drafts, slower
# WES_AI_MAX_CANDIDATES=40

# Only for WES_AI_BACKEND=claude
# ANTHROPIC_API_KEY=
# WES_MODEL=claude-opus-5-5
# WES_AI_EFFORT=high

WES_LAB_NAME=Anderson Diagnostics & Labs
WES_LAB_ADDRESS=
WES_LAB_ACCREDITATION=

# Optional HTTP basic auth: user:password,user2:password2
WES_USERS=

# Filtering thresholds
# WES_AF_DOMINANT=0.0005
# WES_AF_RECESSIVE=0.01
# WES_MIN_DP=8
# WES_MIN_GQ=20
# WES_VEP_FORKS=8
