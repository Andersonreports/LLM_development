# Patient data must never be committed. These patterns apply to the whole repository,
# so a stray VCF dropped in any folder cannot be added by accident.
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bam
*.bam.bai
*.cram
*.fastq
*.fastq.gz
*.fq.gz
data/
uploads/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# Signed reports carry patient names, PINs and clinical history. The whole
# ground-truth folder stays local; only de-identified facts go in the repo.
trainig_datasets/
training_datasets/
*.pdf
!ADVAT_LLM_Project_Roadmap.docx.pdf
